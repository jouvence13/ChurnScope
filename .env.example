# Environment Variables Example for ChurnScope
# Copy to .env and set your actual values

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Security / PII Anonymization Salt (secret string for HMAC hashing)
ANONYMIZATION_SALT=churnscope-secret-salt-replace-in-production

# Model & Data paths (optional overrides)
DATA_RAW_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
MODEL_EXPORT_PATH=data/processed/churn_model.joblib
PREDICTIONS_EXPORT_PATH=data/processed/customer_predictions.csv
